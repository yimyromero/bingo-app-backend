# copy to .env and fill in
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/bingo
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Base URL of the frontend, used to build password reset links
FRONTEND_URL=http://localhost:5173

# SMTP settings used to send password reset emails
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bingo <no-reply@example.com>"
